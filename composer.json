{
  "name": "morphp/medas-html-templates-http-request-handler-bridge",
  "description": "Medas bridge between HTML templates and http request handler",
  "keywords": [
    "frontend",
    "http"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "morphp/medas-core": "^4",
    "morphp/medas-html-templates": "^3",
    "morphp/medas-http-request-handler": "^3",
    "ext-dom": "*"
  },
  "require-dev": {
    "morphp/medas-object-instantiator": "^4",
    "morphp/medas-service-manager": "^4",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\HtmlTemplatesHttpRequestHandlerBridge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Medas\\HtmlTemplatesHttpRequestHandlerBridgeTest\\": "tests/"
    }
  }
}
